# Public URL of this portal. Use https://portal.carted.ca in production.
AUTH_URL=https://portal.carted.ca
AUTH_TRUST_HOST=true

# Discord Developer Portal application credentials.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Generate with: npx auth secret
AUTH_SECRET=

# Added automatically when Neon is installed from Vercel Marketplace.
DATABASE_URL=

# Comma-separated Discord user IDs allowed to manage member orders and fees.
ADMIN_DISCORD_IDS=

# Stripe server-side API key and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
